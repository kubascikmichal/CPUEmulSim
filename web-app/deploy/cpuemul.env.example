# Secrets for the CPU Emulator service. Install as /etc/cpuemul/cpuemul.env, mode 0600, owner root.
# Read by systemd (EnvironmentFile=) - never commit the real file.

# Path of the server configuration
CPUEMUL_CONFIG=/etc/cpuemul/server.yaml

# Administrator (auth.mode: local). Assigns the teacher / student role and manages every account.
# The account is not stored on disk; this name cannot be registered. Password: 8-128 characters.
# Leave both empty for no administrator; setting only one of them stops the service at start-up.
CPUEMUL_ADMIN_USERNAME=
CPUEMUL_ADMIN_PASSWORD=

# Password of the LDAP service account (ldap.bind.serviceDn). Only needed once LDAP is configured.
LDAP_SERVICE_PASSWORD=
